# Copy to .env and fill in. BYOK — these are YOUR keys; nothing routes through anyone else.
# The deterministic phases (recon, deps, SAST, ZAP/nuclei, PyRIT marker test) need NONE of these.

# Unlocks every AI phase: AgentGG (phase 5), PyRIT smart layer (6c), mcp-scanner LLM analyzer (4).
OPENROUTER_API_KEY=

# AgentGG: point it at OpenRouter (NOT the Anthropic path — that hits an autocompact-loop bug).
# Set whatever env/flags your installed agentgg version expects to use OpenRouter; e.g.:
# AGENTGG_PROVIDER=openrouter
# AGENTGG_MODEL=anthropic/claude-sonnet-4.5

# mcp-scanner LLM + behavioral analyzers read this (reuse your OpenRouter key or set another):
# MCP_SCANNER_LLM_API_KEY=
